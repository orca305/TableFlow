# Copy to .env and replace the values. Never commit .env.
# 서버 상태 DB(필수). scripts/backend.ps1이 이 값을 읽는다.
TABLEFLOW_STATE_DB_PASSWORD=replace-with-a-random-state-db-password
TABLEFLOW_MYSQL_PASSWORD=replace-with-a-random-local-password
TABLEFLOW_MYSQL_ROOT_PASSWORD=replace-with-another-random-local-password

# Spring Boot: set these in the backend process environment (not loaded from this file).
# TABLEFLOW_JDBC_ENABLED=true
# TABLEFLOW_JDBC_ALLOWED_HOSTS=localhost,127.0.0.1
